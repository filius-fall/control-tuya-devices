CLIENTKEY="<Access ID / Client ID from Tuya IoT Platform>"
CLIENTSECRET="<Access Secret / Client Secret from Tuya IoT Platform>"
APIREGION="<Data center region: in, eu, us, cn, etc.>"

# Poll interval (seconds)
TUYA_POLL_INTERVAL=30
TUYA_DISCOVER_INTERVAL=3600

# Webhook push (optional — leave empty to disable)
WEBHOOK_URLS="http://localhost:8080/api/readings"
WEBHOOK_TIMEOUT=10
WEBHOOK_RETRIES=3
WEBHOOK_RETRY_DELAY=1.0
WEBHOOK_BATCH=true
