CLIENTKEY="<Access ID / Client ID from Tuya IoT Platform>"
CLIENTSECRET="<Access Secret / Client Secret from Tuya IoT Platform>"
APIREGION="<Data center region: in, eu, us, cn, etc.>"

# Webhook settings (optional — leave empty to disable)
WEBHOOK_URLS="http://localhost:8080/api/readings,http://localhost:9091/metrics/job/tuya"
WEBHOOK_TIMEOUT=10
WEBHOOK_RETRIES=3
WEBHOOK_RETRY_DELAY=1.0
WEBHOOK_BATCH=true

# Poll interval for serve mode (seconds)
POLL_INTERVAL=60
